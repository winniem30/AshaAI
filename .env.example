# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ashaai
MONGODB_DB_NAME=ashaai

# Firebase Client Configuration (VITE_ prefix for client-side access)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin Configuration (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password

# Backend Configuration (Not needed for TanStack Start deployment)
# BACKEND_PORT=4000
# FRONTEND_ORIGIN=http://localhost:8080
